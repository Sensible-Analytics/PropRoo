# Render Blueprint - PropRoo Monorepo
# Docs: https://render.com/docs/blueprint-spec
#
# IMPORTANT: Set the following secrets in the Render dashboard (not in this file):
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ENDPOINT, REDIS_URL

# PostgreSQL Database (managed by Render)
databases:
  - name: proproo-db
    databaseName: proproo
    ipAllowList: []
    postgresVersion: "16"

# Backend: FastAPI Python Web Service
services:
  - type: web
    name: proproo-backend
    runtime: python
    region: singapore
    plan: free
    rootDir: backend
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn app.main:app --host 0.0.0.0 --port $PORT
    healthCheckPath: /api/health
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: proproo-db
          property: connectionString
      - key: PYTHON_VERSION
        value: "3.12"
      - key: DATA_DIR
        value: /tmp
      # Cloudflare R2 — set these in Render dashboard as secret env vars
      - key: R2_ACCOUNT_ID
        sync: false
      - key: R2_ACCESS_KEY_ID
        sync: false
      - key: R2_SECRET_ACCESS_KEY
        sync: false
      - key: R2_BUCKET_NAME
        value: proproo-data
      - key: R2_ENDPOINT
        sync: false
      # Upstash Redis — set in Render dashboard as secret env var
      - key: REDIS_URL
        sync: false
      - key: ENVIRONMENT
        value: production

  # Frontend: React + Vite Static Site
  - type: web
    name: proproo-frontend
    runtime: static
    rootDir: frontend
    buildCommand: npm install && npm run build
    staticPublishPath: ./dist
    routes:
      - type: rewrite
        source: /*
        destination: /index.html
    headers:
      - path: /*
        name: X-Frame-Options
        value: sameorigin
      - path: /*
        name: X-Content-Type-Options
        value: nosniff
      - path: /*
        name: Referrer-Policy
        value: strict-origin-when-cross-origin
    envVars:
      - key: NODE_VERSION
        value: "18"
      - key: VITE_API_URL
        value: https://proproo-backend.onrender.com/api
    domains:
      - proproo.sensibleanalytics.co
